extends Node

## Runtime secrets template
## Copy this file to `src/scripts/singletons/runtime_secrets.gd` and fill in
## real values during the build/release pipeline. The copied `.gd` file is
## gitignored and must never be committed.

## Set to true once a real secret has been injected.
var is_set := false

## HMAC secret used by SaveManager to sign save files. Must match the value
## used by the build/export pipeline.
var HMAC_SECRET := "CHANGE_ME_IN_BUILD_PIPELINE"

## Optional SilentWolf integration placeholders (deferred to post-launch).
# var SILENT_WOLF_API_KEY := ""
# var SILENT_WOLF_GAME_ID := ""
